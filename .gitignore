# Build output
out/

# YOUR real career data -- never committed. profile.example/ is the public
# stand-in that tests and development use (CLAUDE.md).
profile/

# Upstream template + license, fetched by scripts, not authored here.
.vendor/

# Parsed job descriptions, keyed on a hash of the posting + model + prompt.
# Rebuildable and potentially large; the committed record lives in
# tests/snapshots/jd/ instead.
.cache/

# Derived search index. YAML is the source of truth; this is a rebuildable
# cache keyed on a hash of the profile, so it must never be committed.
.index/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# LaTeX intermediates. Scoped to out/ on purpose: a bare `*.log` would also
# ignore tests/fixtures/*.log, which are checked-in parser fixtures.
out/**/*.aux
out/**/*.fls
out/**/*.fdb_latexmk
out/**/*.synctex.gz

# Env
.env
